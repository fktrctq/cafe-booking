# ============================================
# Application Settings
# ============================================
# Название приложения (отображается в Swagger)
APP_TITLE=APP title
# Описание приложения (отображается в Swagger)
APP_DESCRIPTIONS=Описание проекта.
# Версия приложения
VERSION=1.0.0
# Автор приложения
APP_AUTHOR=Author
# Минимальная длина пароля
MIN_PASSWORD_LENGTH=5
# Включить запись логов в файл (true/false)
LOG_TO_FILE=true
# Уровень логирования (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=DEBUG
# Формат логов (standard, json)
LOG_FORMATTER=standard
# Формат времени в логах
TIME_FORMAT=%Y-%m-%dT%H:%M:%S
# Часовой пояс приложения
TIME_ZONE=Asia/Yekaterinburg
# Порт приложения (внутри контейнера)
APP_PORT=8000
# Доверенные прокси (список IP/сетей через запятую)
TRUSTED_PROXY=172.16.0.0/24,127.0.0.1

# ============================================
# PostgreSQL Database
# ============================================
# Часовой пояс для БД
TZ=Asia/Yekaterinburg
# Часовой пояс для PostgreSQL
PGTZ=Asia/Yekaterinburg
# Имя БД
POSTGRES_DB=cafe
# Имя БД для pytest
DB_PYTEST=cafe_test
# Хост БД (имя сервиса в docker-compose)
POSTGRES_HOST=db
# Порт БД
POSTGRES_PORT=5432
# Монтирование диска к данным PostgreSQL внутри контейнера
PGDATA=/var/lib/postgresql/data/pgdata

# ============================================
# Database Pool Settings
# Настройки пула соединений для разных сервисов
# ============================================
# Backend (FastAPI)
BACKEND_DB_POOL_SIZE=100
BACKEND_DB_MAX_OVERFLOW=150
BACKEND_DB_POOL_TIMEOUT=30
BACKEND_DB_POOL_RECYCLE=3600
# Celery Worker
CELERY_DB_POOL_SIZE=50
CELERY_DB_MAX_OVERFLOW=100
CELERY_DB_POOL_TIMEOUT=60
CELERY_DB_POOL_RECYCLE=1800

# ============================================
# RabbitMQ (Message Broker)
# ============================================
# Хост RabbitMQ
RABBITMQ_HOST=rabbitmq
# Виртуальный хост
RABBITMQ_DEFAULT_VHOST=/
# Порт AMQP
RABBITMQ_PORT=5672
# Порт Management UI
RABBITMQ_MANAGEMENT_PORT=15672
# URL для результатов Celery
RESULT_BACKEND_URL=rpc://

# ============================================
# Flower (Celery Monitoring)
# ============================================
# Порт Flower
FLOWER_PORT=5555

# ============================================
# Celery Worker
# ============================================
# Количество конкурентных воркеров
WORKER_CONCURRENCY=10
# Максимальное количество повторных попыток
MAX_RETRIES=3
# Ограничение скорости выполнения задач
RATE_LIMIT=100/m

# ============================================
# Email (SMTP)
# ============================================
# SMTP сервер
SMTP_SERVER=smtp.mail.selcloud.ru
# SMTP порт
SMTP_PORT=1127
# Использовать SSL
SMTP_USE_SSL=True
# Использовать TLS (если True, то SSL должен быть False)
SMTP_USE_TLS=False
# Формат времени в сообщениях
TIME_FORMAT_MESSAGE=%d.%m.%Y %H:%M

# ============================================
# Media files
# ============================================
# Максимальный размер загружаемого файла (в байтах)
MAX_FILE_SIZE=5242880
# Разрешённые расширения для медиа-файлов
ALLOWED_EXTENSIONS_MEDIA=.jpg,.jpeg,.png

# ============================================
# Redis cache
# ============================================
# Хост Redis
REDIS_HOST=redis
# Порт Redis
REDIS_PORT=6379
# Максимальное количество соединений с Redis
REDIS_MAX_CONNECTIONS=300
# Максимальное время повторного подключения к Redis
REDIS_MAX_RECONNECT_BACKOFF=120
