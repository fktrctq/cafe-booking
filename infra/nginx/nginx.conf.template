server {
    listen 8080;
    server_tokens off;
    client_max_body_size 20M;
    proxy_read_timeout 300;
    proxy_connect_timeout 300;
    proxy_send_timeout 300;


    # API v1
    location /api/v1/ {
        include /etc/nginx/conf.d/proxy-headers.conf;
        proxy_pass http://backend:${APP_PORT}/api/v1/;
    }

    # Swagger UI
    location /docs {
        include /etc/nginx/conf.d/proxy-headers.conf;
        proxy_pass http://backend:${APP_PORT}/docs;
    }

    # ReDoc
    location /redoc {
        include /etc/nginx/conf.d/proxy-headers.conf;
        proxy_pass http://backend:${APP_PORT}/redoc;
    }

    # OpenAPI JSON
    location /openapi.json {
        include /etc/nginx/conf.d/proxy-headers.conf;
        proxy_pass http://backend:${APP_PORT}/openapi.json;
    }

    # Health check
    location /health {
        include /etc/nginx/conf.d/proxy-headers.conf;
        proxy_pass http://backend:${APP_PORT}/api/v1/health;
    }

    # Flower
    location /flower/ {
        include /etc/nginx/conf.d/proxy-headers.conf;
        include /etc/nginx/conf.d/proxy-websocket.conf;
        proxy_pass http://flower:${FLOWER_PORT}/;
    }

    # RabbitMQ management
    location /rabbitmq/ {
        include /etc/nginx/conf.d/proxy-headers.conf;
        include /etc/nginx/conf.d/proxy-websocket.conf;
        proxy_pass http://rabbitmq:${RABBITMQ_MANAGEMENT_PORT}/;
    }
}
