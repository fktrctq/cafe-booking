# ============================================
# Application Settings
# ============================================
# Название приложения (отображается в Swagger)
APP_TITLE=Cafe booking API
# Описание приложения (отображается в Swagger)
APP_DESCRIPTIONS=Сервис бронирования столиков в кафе с асинхронной обработкой задач
# Версия приложения
VERSION=1.0.0
# Автор приложения
APP_AUTHOR=Author
# Алгортм шифрования JWT токена
ALGORITHM=HS256
# Секретный ключ для JWT и сессий (обязательно измените в продакшене!)
SECRET=supersecretkey
# Email суперпользователя (пользователь создаётся при первом запуске)
SUPERUSER_EMAIL=admin@cafe-booking.com
# Имя суперпользователя
SUPERUSER_NAME=superadmin
# Пароль суперпользователя
SUPERUSER_PASSWORD=userpaswd
# Минимальная длина пароля
MIN_PASSWORD_LENGTH=5
# Включить запись логов в файл (true/false)
LOG_TO_FILE=true
# Уровень логирования (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=DEBUG
# Формат логов (standard, json)
LOG_FORMATTER=standard
# Формат времени в логах
TIME_FORMAT=%Y-%m-%dT%H:%M:%S
# Часовой пояс приложения
TIME_ZONE=Asia/Yekaterinburg
# Порт приложения (внутри контейнера)
APP_PORT=8000
# Разрешённые источники для CORS (список через запятую)
ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://127.0.0.1,http://localhost,http://cafe-booking.ruviewer.ru,http://www.cafe-booking.ruviewer.ru,https://cafe-booking.ruviewer.ru,https://www.cafe-booking.ruviewer.ru
# Доверенные прокси (список IP/сетей через запятую)
TRUSTED_PROXY=172.16.0.0/24,127.0.0.1
# Максимальный размер загружаемого файла (в байтах)
MAX_FILE_SIZE=5242880
# Разрешённые расширения для медиа-файлов
ALLOWED_EXTENSIONS_MEDIA=.jpg,.jpeg,.png

# ============================================
# Docker Hub (для CI/CD)
# ============================================
# Пароль или токен доступа к Docker Hub
DOCKER_PASSWORD=
# Имя пользователя Docker Hub
DOCKER_USERNAME=

# ============================================
# PostgreSQL Database
# ============================================
# Часовой пояс для БД
TZ=Asia/Yekaterinburg
# Часовой пояс для PostgreSQL
PGTZ=Asia/Yekaterinburg
# Пользователь БД
POSTGRES_USER=postgres
# Пароль БД (обязательно измените в продакшене!)
POSTGRES_PASSWORD=postgres
# Имя БД
POSTGRES_DB=cafe
# Имя БД для pytest
DB_PYTEST=cafe_test
# Хост БД (имя сервиса в docker-compose)
POSTGRES_HOST=db
# Порт БД
POSTGRES_PORT=5432
# Монтирование диска к данным PostgreSQL внутри контейнера
PGDATA=/var/lib/postgresql/data/pgdata

# ==============================================================================
# Database Pool Settings Настройки пула соединений для разных сервисов
# ==============================================================================
# Backend (FastAPI)
BACKEND_DB_POOL_SIZE=100
BACKEND_DB_MAX_OVERFLOW=150
BACKEND_DB_POOL_TIMEOUT=30
BACKEND_DB_POOL_RECYCLE=3600
# Celery Worker
CELERY_DB_POOL_SIZE=50
CELERY_DB_MAX_OVERFLOW=100
CELERY_DB_POOL_TIMEOUT=60
CELERY_DB_POOL_RECYCLE=1800

# ============================================
# RabbitMQ (Message Broker)
# ============================================
# Хост RabbitMQ
RABBITMQ_HOST=rabbitmq
# Пользователь RabbitMQ
RABBITMQ_DEFAULT_USER=userrabbit
# Пароль RabbitMQ
RABBITMQ_DEFAULT_PASS=rabbit
# Виртуальный хост
RABBITMQ_DEFAULT_VHOST=/
# Порт AMQP
RABBITMQ_PORT=5672
# Порт Management UI
RABBITMQ_MANAGEMENT_PORT=15672
# URL для результатов Celery
RESULT_BACKEND_URL=rpc://

# ============================================
# Flower (Celery Monitoring)
# ============================================
# Порт Flower
FLOWER_PORT=5555
# Базовая аутентификация Flower (формат: login:password)
FLOWER_BASIC_AUTH=admin:flowerpass

# ============================================
# Celery Worker
# ============================================
# Количество конкурентных воркеров
WORKER_CONCURRENCY=10
# Максимальное количество повторных попыток
MAX_RETRIES=3
# Ограничение скорости выполнения задач
RATE_LIMIT=100/m
# ============================================
# Redis cache
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379

# ============================================
# Email (SMTP)
# ============================================
# SMTP сервер
SMTP_SERVER=smtp.mail.ru
# SMTP порт
SMTP_PORT=465
# Использовать SSL
SMTP_USE_SSL=True
# Использовать TLS (если True, то SSL должен быть False)
SMTP_USE_TLS=False
# Пользователь SMTP (email)
SMTP_USER=
# Email отправителя некоторые серверы требуют совпадения с SMTP_USER
SMTP_FROM_EMAIL=
# Пароль приложения SMTP (SMTP_USER)
SMTP_PASSWORD=
# Формат времени в сообщениях
TIME_FORMAT_MESSAGE=%d.%m.%Y %H:%M
