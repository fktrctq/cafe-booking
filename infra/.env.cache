# ============================================
# Настройки кеширования
# ============================================

# ----- Общие настройки -----
LOCK_WAIT_TIMEOUT=3      # таймаут ожидания обновления кеша, сек
PREFIX=dev               # префикс для ключей (dev/prod/staging)
TTL_CACHE=90             # время жизни кеша, сек
STALE_TTL_CACHE=45       # время жизни устаревшего кеша, сек

# ----- MiddlewareAuth -----
AUTH_CACHE=true          # включить кеширование авторизации
AUTH_TTL=1800            # время жизни auth кеша (30 мин)
AUTH_STALE_TTL=300       # устаревший auth кеш, сек
AUTH_KEY=auth            # ключ для auth
AUTH_TAG=tag_auth        # тег для auth

# ----- Booking -----
BOOKING_TTL=90
BOOKING_STALE_TTL=45
BOOKING_PREFIX=prx_booking
BOOKING_TAG=tag_booking
BOOKING_LIST_TAG=tag_bookings

# ----- Cafe -----
CAFE_TTL=90
CAFE_STALE_TTL=45
CAFE_PREFIX=prx_cafe
CAFE_TAG=tag_cafe
CAFE_LIST_TAG=tag_cafes

# ----- Slot -----
SLOT_TTL=90
SLOT_STALE_TTL=45
SLOT_PREFIX=prx_slot
SLOT_TAG=tag_slot
SLOT_LIST_TAG=tag_slots

# ----- Table -----
TABLE_TTL=90
TABLE_STALE_TTL=45
TABLE_PREFIX=prx_table
TABLE_TAG=tag_table
TABLE_LIST_TAG=tag_tables

# ----- User -----
USER_TTL=1800
USER_STALE_TTL=300
USER_PREFIX=prx_user
USER_TAG=tag_user
USER_LIST_TAG=tag_users
